# 用法：cp .env.example .env && vi .env
# .env 已被 .gitignore 忽略，绝不入库；密钥只由 compose 在运行时注入容器
# 只有 AI 导购需要密钥，其余容器不需要额外配置

DEEPSEEK_API_KEY=sk-填你在本机 ai-service/.env 里的那个值
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 后端/MySQL 需要的密钥（生产务必改为独立强密码，不要使用示例值）
MYSQL_ROOT_PASSWORD=your_mysql_password
JWT_SECRET=pleaseChangeThisJwtSecretBeforeDeploy
