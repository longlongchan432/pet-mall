<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.petmall.mapper.CouponMapper">
    <resultMap id="BaseResultMap" type="com.petmall.entity.Coupon">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="type" property="type"/>
        <result column="threshold" property="threshold"/>
        <result column="value" property="value"/>
        <result column="stock" property="stock"/>
        <result column="total" property="total"/>
        <result column="status" property="status"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectAvailable" resultMap="BaseResultMap">
        SELECT * FROM coupon
        WHERE status = 1 AND stock > 0
          AND (start_time IS NULL OR start_time &lt;= #{now})
          AND (end_time IS NULL OR end_time &gt;= #{now})
        ORDER BY id DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM coupon WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.petmall.entity.Coupon" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO coupon (name, type, threshold, value, stock, total, status, start_time, end_time, create_time, update_time)
        VALUES (#{name}, #{type}, #{threshold}, #{value}, #{stock}, #{total}, #{status}, #{startTime}, #{endTime}, #{createTime}, #{updateTime})
    </insert>

    <update id="decreaseStock">
        UPDATE coupon SET stock = stock - 1 WHERE id = #{id} AND stock > 0
    </update>
</mapper>